{
	"schemaVersion": 1,
	"id": "monkeysmp-core",
	"version": "${version}",
	"name": "MonkeySMP Core",
	"description": "Core utilities of MonkeySMP",
	"authors": [
		"JustMangoo"
	],
	"license": "MIT",
	"icon": "assets/monkey-smp-core/icon.png",
	"environment": "*",
